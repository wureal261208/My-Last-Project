{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/reader-text/(.*)",
      "destination": "/api/reader-text"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/books.js": { "maxDuration": 30 },
    "api/books/[...path].js": { "maxDuration": 30 },
    "api/rentals.js": { "maxDuration": 30 },
    "api/rentals/[...path].js": { "maxDuration": 30 },
    "api/users.js": { "maxDuration": 30 },
    "api/users/[...path].js": { "maxDuration": 30 },
    "api/auth.js": { "maxDuration": 30 },
    "api/auth/[...path].js": { "maxDuration": 30 },
    "api/comments.js": { "maxDuration": 30 },
    "api/comments/[...path].js": { "maxDuration": 30 },
    "api/migrate.js": { "maxDuration": 60 },
    "api/migrate/[...path].js": { "maxDuration": 60 }
  }
}